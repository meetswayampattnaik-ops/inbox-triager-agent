# Copy this file to .env and fill in your values. NEVER commit .env

# ---- Choose ONE provider -------------------------------------------------
# groq      = FREE cloud API, no credit card (recommended)  -> get key at console.groq.com/keys
# ollama    = FREE, runs fully on your own laptop (no key, no internet needed after download)
# anthropic = paid Claude API (optional)
LLM_PROVIDER=groq

# Groq (free)
GROQ_API_KEY=paste-your-groq-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Ollama (free, local)
OLLAMA_MODEL=llama3.1

# Anthropic (paid, optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Mailbox -------------------------------------------------------------
# demo = uses data/sample_emails.json (no email account needed)
# imap = connects to your real mailbox
MAILBOX_MODE=demo
MAX_EMAILS=10

IMAP_HOST=imap.gmail.com
IMAP_USER=you@gmail.com
# Gmail: create an App Password (needs 2-Step Verification). Do NOT use your normal password.
IMAP_PASSWORD=your-app-password
IMAP_IS_GMAIL=true
IMAP_DRAFTS_FOLDER=[Gmail]/Drafts

# Your name, used to sign drafts
USER_NAME=Your Name
